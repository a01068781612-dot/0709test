  "tone": "한국어 뉴스 나레이션처럼 또박또박, 차분하고 신뢰감 있게 읽어라",
  "lines": [
    {"id":  1, "start":  0.2, "end":  2.8, "text": "부산 다중이용업소 1만 2천 개소"},
    {"id":  2, "start":  3.1, "end":  5.0, "text": "조사 순서를 어떻게 정할까요"},
    {"id":  3, "start":  5.1, "end":  7.0, "text": "구에서 동으로 좁힙니다"},
    {"id":  4, "start":  7.2, "end":  9.1, "text": "북구 구포동 191개소"},
    {"id":  5, "start":  9.2, "end": 11.0, "text": "오늘 갈 곳을 체크하고"},
    {"id":  6, "start": 11.1, "end": 13.0, "text": "동선 짜기를 누릅니다"},
    {"id":  7, "start": 13.3, "end": 15.1, "text": "거리 기준으로 묶어"},
    {"id":  8, "start": 15.2, "end": 17.1, "text": "사흘치 순서를 자동으로"},
    {"id":  9, "start": 17.3, "end": 19.1, "text": "업소를 누르면 조사 카드"},
    {"id": 10, "start": 19.2, "end": 21.1, "text": "두 기관 자료를 한 화면에"},
    {"id": 11, "start": 21.4, "end": 23.4, "text": "왜 1위인지 근거가 보입니다"},
    {"id": 12, "start": 23.5, "end": 25.5, "text": "네 개 그룹 열다섯 개 지표"},
    {"id": 13, "start": 25.6, "end": 27.6, "text": "같은 동, 같은 업종과 비교"},
    {"id": 14, "start": 27.7, "end": 29.8, "text": "판단 기준이 화면에 남습니다"},
    {"id": 15, "start": 29.9, "end": 32.0, "text": "따로 정리할 필요가 없습니다"},
    {"id": 16, "start": 32.5, "end": 34.6, "text": "예방행정시스템 화면입니다"},
    {"id": 17, "start": 34.7, "end": 36.7, "text": "MCP로 연결할 수 있습니다"},
    {"id": 18, "start": 36.8, "end": 39.0, "text": "그러면 로그인하고 찾을 필요 없이"},
    {"id": 19, "start": 39.1, "end": 41.3, "text": "필요한 탭을 바로 열 수 있습니다"},
    {"id": 20, "start": 41.4, "end": 43.8, "text": "오가며 쓰던 시간을 줄입니다"},
    {"id": 21, "start": 44.4, "end": 46.4, "text": "도면도 같은 화면에서"},
    {"id": 22, "start": 46.5, "end": 48.7, "text": "완비증명 첨부도면을 불러오고"},
    {"id": 23, "start": 48.8, "end": 50.8, "text": "찍어온 사진을"},
    {"id": 24, "start": 50.9, "end": 53.2, "text": "촬영 지점에 놓기만 하면"},
    {"id": 25, "start": 53.3, "end": 55.6, "text": "세 장이 모두 연결됩니다"},
    {"id": 26, "start": 55.7, "end": 58.2, "text": "대조를 실행합니다"},
    {"id": 27, "start": 58.6, "end": 61.0, "text": "도면에 없는 칸막이가 보입니다"},
    {"id": 28, "start": 61.1, "end": 63.6, "text": "판정은 현장 담당자가 합니다"},
    {"id": 29, "start": 64.2, "end": 66.1, "text": "말로 물어도 됩니다"},
    {"id": 30, "start": 66.2, "end": 68.2, "text": "여러 기관 자료를 묶어"},
    {"id": 31, "start": 68.3, "end": 70.4, "text": "12개소를 바로 보여줍니다"},
    {"id": 32, "start": 70.5, "end": 72.5, "text": "119 세이프리스트"}
  ]
}
